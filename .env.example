# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the applet.
APP_URL="MY_APP_URL"

# Cloud SQL (PostgreSQL) runtime & schema variables (automatically injected by AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional GitHub OAuth App credentials for popup GitHub repository export (/auth/github/callback)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

